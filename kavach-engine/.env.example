# Only needed for the live provider. The mock provider needs nothing.
ANTHROPIC_API_KEY=
KAVACH_LLM_PROVIDER=mock   # mock | anthropic
PORT=8787

# Session persistence. Sessions hold a verbatim transcript of an encounter with
# police, so durability is a trade, not a free win — see src/server/store.ts and
# the PRD's open question about who can be compelled to produce evidence.
#
# 0 restores the old behaviour exactly: sessions live in memory and the lawyer
# packet dies with the process.
KAVACH_PERSIST_SESSIONS=1
KAVACH_SESSION_DIR=./sessions
# Swept on boot. Evidence nobody has collected in a week is a liability.
KAVACH_SESSION_RETENTION_DAYS=7
