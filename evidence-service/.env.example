PORT=8789

# Where chunks land. This directory holds audio of encounters with police.
KAVACH_EVIDENCE_DIR=./evidence

# Swept on boot. The PRD requires a user to be able to delete evidence and for
# deletion to be honoured within 24 hours; a retention ceiling is the other
# half of that. Evidence nobody has collected in a month is a liability.
KAVACH_EVIDENCE_RETENTION_DAYS=30

# Per-session ceiling, in megabytes. A runaway client must not be able to fill
# the disk of the machine holding everyone else's evidence.
KAVACH_EVIDENCE_MAX_SESSION_MB=200
