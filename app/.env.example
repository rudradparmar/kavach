# Where the engine lives.
#
# Usually you do not need this. With no value set, the app derives the address
# from the Metro dev-server host and swaps the port to 8787 — which is right
# whenever the engine and the bundler run on the same machine.
#
# Set it when they do not, or when you want a fixed address that survives a
# network change. An in-app override in Settings takes precedence over this.
#
# Copy to .env and edit.
EXPO_PUBLIC_KAVACH_URL=http://192.168.1.8:8787
