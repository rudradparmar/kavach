# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# --- Auth -----------------------------------------------------------------
# Generate each with:  openssl rand -base64 24 | tr -d '=+/'
# Both are required, and must be identical across all three services.
KAVACH_API_KEY=
KAVACH_SESSION_SECRET=
# How long a session capability stays valid. An encounter is minutes; the
# packet is read afterwards, which is what this is really sized for.
KAVACH_SESSION_TTL_HOURS=12

# --- Rotating those two ---------------------------------------------------
# PRD R1 forbids a login, so every phone shares one instance key and there is
# no account to push a new one to. Changing KAVACH_API_KEY alone locks every
# installed app out at the same instant, and the instant anyone notices is a
# police stop.
#
# So rotate in two steps:
#   1. Put the NEW key in KAVACH_API_KEY and the OLD one in KAVACH_API_KEYS.
#      Both are accepted. Ship the new key to clients.
#   2. Once clients have it, empty KAVACH_API_KEYS. The old key stops working.
#
# The overlap is the cost: a leaked key stays usable until you finish step 2.
# Finish it.
#
# KAVACH_SESSION_SECRETS is the same, for session tokens. Those live hours and
# are held by phones mid-encounter; rotating without an overlap stops the audio
# uploading for everyone at once.
#
# Comma separated. The current value is always accepted and never repeated here.
KAVACH_API_KEYS=
KAVACH_SESSION_SECRETS=

# --- Cloudflare Tunnel ----------------------------------------------------
# From the Zero Trust dashboard: Networks -> Tunnels -> Create -> copy token.
# Route api.<your-domain> to http://caddy:80 in the tunnel's public hostname
# settings.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Engine ---------------------------------------------------------------
# mock is the deterministic classifier. It needs no key, runs offline, and is
# the baseline anything else has to beat.
KAVACH_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5. Changing it changes who perceives
# the encounter: run `npm run eval` against the new model first.
KAVACH_ANTHROPIC_MODEL=
KAVACH_SESSION_RETENTION_DAYS=7

# --- Speech ---------------------------------------------------------------
# mock cannot hear. It returns canned lines marked SIMULATED in the response
# and in the transcript text, so guidance built on it is never mistaken for
# guidance about something that happened.
#
# Groq's free tier fits the existing openai-compatible provider with no code
# change -- 2,000 requests and 28,800 audio-seconds a day:
#   KAVACH_STT_PROVIDER=openai-compatible
#   KAVACH_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
#   KAVACH_STT_MODEL=whisper-large-v3-turbo
#   KAVACH_STT_KEY=gsk_...
KAVACH_STT_PROVIDER=mock
KAVACH_STT_URL=
KAVACH_STT_KEY=
KAVACH_STT_MODEL=whisper-1

# --- Evidence -------------------------------------------------------------
KAVACH_EVIDENCE_RETENTION_DAYS=30
KAVACH_EVIDENCE_MAX_SESSION_MB=200
