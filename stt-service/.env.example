# Transcription provider. "mock" (default) needs no key and returns clearly
# marked placeholder text — it exists so the audio pipeline is testable offline.
# "openai-compatible" talks to any /v1/audio/transcriptions endpoint: OpenAI,
# Groq, or a self-hosted whisper.cpp server.
KAVACH_STT_PROVIDER=mock

# Required when KAVACH_STT_PROVIDER=openai-compatible.
KAVACH_STT_URL=https://api.openai.com/v1/audio/transcriptions
KAVACH_STT_KEY=
KAVACH_STT_MODEL=whisper-1

PORT=8788
